{
  "name": "duck-running",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Standalone physical island racing game \u2014 duck running!",
  "scripts": {
    "dev": "node scripts/prepare-browser-runtime.mjs && vite --host 127.0.0.1 --port 5175",
    "build": "node scripts/prepare-browser-runtime.mjs && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 5175",
    "test": "node --test tests/*.test.mjs",
    "check:race": "node scripts/evaluate.mjs",
    "check:roll": "node scripts/check-roll.mjs",
    "check:coast": "node scripts/check-coast.mjs",
    "check:hurdles": "node scripts/check-hurdles.mjs"
  },
  "dependencies": {
    "@mujoco/mujoco": "3.11.0",
    "@xmldom/xmldom": "0.9.12",
    "onnxruntime-web": "1.30.0",
    "three": "0.170.0",
    "vite": "6.4.4"
  },
  "devDependencies": {
    "onnxruntime-node": "1.30.0"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wander521/microduck-running.git"
  },
  "homepage": "https://wander521.github.io/microduck-running/",
  "bugs": {
    "url": "https://github.com/wander521/microduck-running/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "microduck",
    "racing-game",
    "mujoco",
    "threejs",
    "onnx",
    "reinforcement-learning"
  ]
}
